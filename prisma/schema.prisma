generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Connection {
  id            String   @id @default(cuid())
  provider      String   @unique
  encryptedData String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MealEntry {
  id                 String     @id @default(cuid())
  dateKey            String
  mealSlot           String     @default("snack")
  status             String     @default("draft")
  imageUrl           String?
  compressedImageUrl String?
  userDescription    String?
  originalBytes      Int?
  compressedBytes    Int?
  finalKcal          Int?
  modelKcal          Int?
  confidence         Float?
  uncertainty        String?
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  items              MealItem[]

  @@index([dateKey, status])
}

model MealItem {
  id                String           @id @default(cuid())
  mealEntryId       String
  name              String
  portion           String?
  grams             Float?
  kcal              Int
  confidence        Float?
  calculationSource String?
  nutritionSourceId String?
  createdAt         DateTime         @default(now())
  mealEntry         MealEntry        @relation(fields: [mealEntryId], references: [id], onDelete: Cascade)
  nutritionSource   NutritionSource? @relation(fields: [nutritionSourceId], references: [id], onDelete: SetNull)
}

model MealPreset {
  id                String           @id @default(cuid())
  name              String
  imageUrl          String?
  description       String?
  baseKcal          Int
  sourceMealEntryId String?          @unique
  usageCount        Int              @default(0)
  lastUsedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  items             MealPresetItem[]
}

model MealPresetItem {
  id                String           @id @default(cuid())
  presetId          String
  name              String
  portion           String?
  defaultGrams      Float?
  kcal              Int
  confidence        Float?
  calculationSource String?
  nutritionSourceId String?
  createdAt         DateTime         @default(now())
  preset            MealPreset       @relation(fields: [presetId], references: [id], onDelete: Cascade)
  nutritionSource   NutritionSource? @relation(fields: [nutritionSourceId], references: [id], onDelete: SetNull)
}

model NutritionSource {
  id              String           @id @default(cuid())
  name            String
  imageUrl        String?
  kcalPer100g     Float
  proteinPer100g  Float?
  fatPer100g      Float?
  carbsPer100g    Float?
  confidence      Float?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  mealItems       MealItem[]
  mealPresetItems MealPresetItem[]
}

model DailyBurn {
  id                    String    @id @default(cuid())
  dateKey               String    @unique
  ouraRestingKcal       Int?
  ouraActiveKcal        Int?
  ouraTotalKcal         Int?
  intervalsTrainingKcal Int?
  totalBurnKcal         Int?
  sourceStatus          String?
  syncedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model WeightEntry {
  id        String   @id @default(cuid())
  dateKey   String   @unique
  weightKg  Float
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainingActivity {
  id          String    @id @default(cuid())
  intervalsId String    @unique
  dateKey     String
  name        String
  type        String?
  durationSec Int?
  calories    Int?
  startedAt   DateTime?
  raw         String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([dateKey])
}

model SyncRun {
  id        String    @id @default(cuid())
  source    String
  status    String
  message   String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?
}
